{{define "list-staff"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Personal</h3>
  <button
  class="btn btn-block"
  hx-get="htmx/form-register-staff-admin"
  hx-target="#staff-new-account"
  hx-swap="innerHTML"
  >Crear nueva cuenta</button>
  <div id="staff-new-account" class="hx-slot"></div>
  {{if not .Staff}}
    <p class="empty-msg">No hay personal</p>
  {{else}}
    {{$endpoint := "/dashboard/admin/staff"}}
    {{$target := "#db-staff-list"}}
    <div class="sort-bar">
      {{template "sort-link" (dict "Field" "username"     "Label" "Usuario" "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "full_name"    "Label" "Nombre"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "time_created" "Label" "Creado"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "active"       "Label" "Activo"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "admin"        "Label" "Admin"   "Params" .Params "Endpoint" $endpoint "Target" $target)}}
    </div>
    <ul class="row-card-list">
      {{range .Staff}}
      <li class="row-card" id="staff-{{.Username}}">
        <div class="row-card-head">
          <span class="row-card-id">{{.Username}}</span>
          {{template "staff-active-cell" (dict "Username" .Username "Active" .Active "OOB" false)}}
        </div>
        <dl class="row-card-fields">
          <div class="row-card-field">
            <dt>Nombre</dt>
            <dd>{{.FullName}}</dd>
          </div>
          <div class="row-card-field">
            <dt>Creado</dt>
            <dd>{{UnixToTime .TimeCreated}}</dd>
          </div>
          <div class="row-card-field">
            <dt>Admin</dt>
            <dd>{{if .Admin}}Sí{{else}}No{{end}}</dd>
          </div>
        </dl>
        {{template "staff-actions-cell" (dict "Username" .Username "Active" .Active "OOB" false)}}
      </li>
      {{end}}
    </ul>
    {{template "list-pagination" (dict "Params" .Params "HasNext" .HasNext "Endpoint" $endpoint "Target" $target)}}
  {{end}}
</div>

{{end}}

{{define "staff-active-cell"}}
<span id="staff-active-{{.Username}}" class="row-card-status" {{if .OOB}}hx-swap-oob="true"{{end}}>{{if .Active}}Activo{{else}}Inactivo{{end}}</span>
{{end}}

{{define "staff-actions-cell"}}
<div id="staff-actions-{{.Username}}" class="row-card-actions" {{if .OOB}}hx-swap-oob="true"{{end}}>
  {{if .Active}}
  <button
  class="btn btn-compact btn-danger"
  hx-patch="/dashboard/admin/staff/deactivate/{{.Username}}"
  hx-vals='{"username":"{{.Username}}"}'
  hx-target="#msg-staff-{{.Username}}"
  hx-swap="innerHTML"
  hx-confirm="¿Desactivar la cuenta de {{.Username}}?"
  >Desactivar</button>
  {{end}}
  <span id="msg-staff-{{.Username}}" class="row-msg"></span>
</div>
{{end}}
