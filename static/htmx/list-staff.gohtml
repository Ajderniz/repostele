{{define "list-staff"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Personal</h3>
  <button
  class="btn btn-block"
  hx-get="htmx/form-register-staff-admin"
  hx-target="#staff-new-account"
  hx-swap="innerHTML"
  >Crear nueva cuenta</button>
  <div id="staff-new-account" class="hx-slot"></div>
  {{if not .Staff}}
    <p class="empty-msg">No hay personal</p>
  {{else}}
    {{$endpoint := "/dashboard/admin/staff"}}
    {{$target := "#db-staff-list"}}
    <table class="data-table">
      <tr>
        {{template "sort-th" (dict "Field" "username"     "Label" "Usuario" "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "full_name"    "Label" "Nombre"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "time_created" "Label" "Creado"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "active"       "Label" "Activo"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "admin"        "Label" "Admin"   "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        <th>Acciones</th>
      </tr>
      {{range .Staff}}
      <tr id="staff-{{.Username}}">
        <td>{{.Username}}</td>
        <td>{{.FullName}}</td>
        <td>{{UnixToTime .TimeCreated}}</td>
        <td>{{if .Active}}Sí{{else}}No{{end}}</td>
        <td>{{if .Admin}}Sí{{else}}No{{end}}</td>
        <td>
          {{if .Active}}
          <button
          class="btn btn-compact"
          hx-patch="/dashboard/admin/staff/deactivate/{{.Username}}"
          hx-vals='{"username":"{{.Username}}"}'
          hx-target="#msg-staff-{{.Username}}"
          hx-swap="innerHTML"
          hx-confirm="¿Desactivar la cuenta de {{.Username}}?"
          >Desactivar</button>
          {{end}}
          <span id="msg-staff-{{.Username}}" class="row-msg"></span>
        </td>
      </tr>
      {{end}}
    </table>
    {{template "list-pagination" (dict "Params" .Params "HasNext" .HasNext "Endpoint" $endpoint "Target" $target)}}
  {{end}}
</div>

{{end}}
