{{define "site-nav"}}

<ul id="site-nav-list-left">
  <li><a href="/menu">Menú</a></li>
  {{if and .LoggedIn .IsStaff}}
    <li>
      <a href="/dashboard">Panel{{template "pending-badge" (dict "Id" "nav-pending-badge" "Count" .PendingOrders "OOB" false)}}</a>
    </li>
  {{end}}
</ul>
<ul id="site-nav-list-right">
  {{if .LoggedIn}}
    {{if not .IsStaff}}
      <li>
        <a href="/cart">Carrito<span id="cart-count" class="nav-badge" hidden></span></a>
      </li>
    {{end}}
    <li><a href="/account">Cuenta</a></li>
    <li>
      <button
      id="login-logout"
      class="site-nav-btn"
      hx-patch="/logout"
      >Salir</button>
    </li>
  {{else}}
    <li><a href="/login" id="login-logout">Acceder</a></li>
  {{end}}
</ul>

{{end}}

{{define "pending-badge"}}<span id="{{.Id}}" class="nav-badge" {{if .OOB}}hx-swap-oob="true"{{end}} {{if not .Count}}hidden{{end}}>{{.Count}}</span>{{end}}
