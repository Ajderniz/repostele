{{define "site-nav"}}

<ul id="site-nav-list-left">
  <li><a href="/menu">Menú</a></li>
  {{if and .LoggedIn .IsStaff}}
    <li>
      <a href="/dashboard">Panel<span class="nav-badge" {{if not .PendingOrders}}hidden{{end}}><svg class="nav-badge-icon" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>{{.PendingOrders}}</span></a>
    </li>
  {{end}}
</ul>
<ul id="site-nav-list-right">
  {{if .LoggedIn}}
    {{if not .IsStaff}}
      <li>
        <a href="/cart">Carrito<span id="cart-count" class="nav-badge" hidden></span></a>
      </li>
    {{end}}
    <li><a href="/account">Cuenta</a></li>
    <li>
      <button
      id="login-logout"
      class="site-nav-btn"
      hx-patch="/logout"
      >Salir</button>
    </li>
  {{else}}
    <li><a href="/login" id="login-logout">Acceder</a></li>
  {{end}}
</ul>

{{end}}
