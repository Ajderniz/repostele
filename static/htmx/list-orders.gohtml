{{define "list-orders"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Órdenes</h3>
  {{if not .Orders}}
    <p class="empty-msg">No hay órdenes</p>
  {{else}}
    <table class="data-table order-list">
      <thead>
        <tr>
          <th class="order-col-id">ID</th>
          <th class="order-col-user">Usuario</th>
          <th class="order-col-total">Total</th>
          <th class="order-col-status">Estado</th>
          <th class="order-col-actions">Acciones</th>
        </tr>
      </thead>
      {{$isStaff := .IsStaff}}
      {{range .Orders}}
        <!--
        TODO: make each order open a detailed order view page ('table-order')
        when clicked
        -->
        {{if not (or (eq .Status 2) (eq .Status 4))}}
          <tbody class="order-block" id="order-{{.Id}}">
            <tr class="order-row">
              <td class="order-col-id">{{.Id}}</td>
              {{if $isStaff}}<td class="order-col-user">{{.User}}</td>{{end}}
              <td class="order-col-total">₡{{.Total}}</td>
              <td class="order-col-status">{{OrderStatusName .Status}}</td>
              <td class="order-col-actions">
                {{template "buttons-order-actions" (dict
                  "IsStaff" $isStaff
                  "Status"  .Status
                  "Id"      .Id
                )}}
              </td>
            </tr>
            <tr class="order-ref-row">
              <td colspan="5">
                <span class="order-ref-label">Referencia</span>
                <code class="order-ref-num">{{.RefNum}}</code>
              </td>
            </tr>
          </tbody>
        {{end}}
      {{end}}
    </table>
  {{end}}
</div>

{{end}}
