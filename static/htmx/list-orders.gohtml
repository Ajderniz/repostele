{{define "list-orders"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Órdenes</h3>
  {{$isStaff := .IsStaff}}
  {{$showHistory := .ShowHistory}}
  {{$endpoint := .Endpoint}}
  {{$target := .Target}}
  {{$anyVisible := false}}
  {{range .Orders}}
    {{if or $showHistory (not (or (eq .Status 2) (eq .Status 4)))}}{{$anyVisible = true}}{{end}}
  {{end}}
  {{if not $anyVisible}}
    <p class="empty-msg">No hay órdenes</p>
  {{else}}
    {{if $isStaff}}
      <div class="sort-bar">
        {{template "sort-link" (dict "Field" "id"     "Label" "ID"      "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-link" (dict "Field" "user"   "Label" "Usuario" "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-link" (dict "Field" "total"  "Label" "Total"   "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-link" (dict "Field" "status" "Label" "Estado"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      </div>
    {{end}}
    <ul class="row-card-list">
      {{range .Orders}}
        {{if or $showHistory (not (or (eq .Status 2) (eq .Status 4)))}}
          <li class="row-card" id="order-{{.Id}}">
            <div class="row-card-head">
              <button
              type="button"
              class="link-btn row-card-id"
              hx-get="{{if $isStaff}}/dashboard/orders/{{.Id}}{{else}}/order/{{.Id}}{{end}}"
              hx-target="#order-detail-{{.Id}}"
              hx-swap="innerHTML"
              >#{{.Id}}</button>
              {{template "order-status" (dict "Id" .Id "Status" .Status "OOB" false)}}
            </div>
            <dl class="row-card-fields">
              {{if $isStaff}}
                <div class="row-card-field">
                  <dt>Usuario</dt>
                  <dd>{{.User}}</dd>
                </div>
              {{end}}
              <div class="row-card-field">
                <dt>Total</dt>
                <dd>₡{{.Total}}</dd>
              </div>
              <div class="row-card-field">
                <dt>Referencia</dt>
                <dd>{{template "order-ref-num" (dict "Id" .Id "RefNum" .RefNum "OOB" false)}}</dd>
              </div>
            </dl>
            {{template "order-actions" (dict "Id" .Id "Status" .Status "IsStaff" $isStaff "OOB" false)}}
            <div id="order-detail-{{.Id}}" class="hx-slot"></div>
          </li>
        {{end}}
      {{end}}
    </ul>
    {{if $isStaff}}
      {{template "list-pagination" (dict "Params" .Params "HasNext" .HasNext "Endpoint" $endpoint "Target" $target)}}
    {{end}}
  {{end}}
</div>

{{end}}

{{define "order-ref-num"}}
<code id="order-ref-{{.Id}}" class="order-ref-num" {{if .OOB}}hx-swap-oob="true"{{end}}>{{.RefNum}}</code>
{{end}}

{{define "order-status"}}
<span id="order-status-{{.Id}}" class="row-card-status" {{if .OOB}}hx-swap-oob="true"{{end}}>{{OrderStatusName .Status}}</span>
{{end}}

{{define "order-actions"}}
<div id="order-actions-{{.Id}}" class="row-card-actions" {{if .OOB}}hx-swap-oob="true"{{end}}>
  {{template "buttons-order-actions" (dict
    "IsStaff" .IsStaff
    "Status"  .Status
    "Id"      .Id
  )}}
</div>
{{end}}
