{{define "list-orders"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Órdenes</h3>
  {{if not .}}
    <p class="empty-msg">No hay órdenes</p>
  {{else}}
    <table class="data-table order-list">
      <thead>
        <tr>
          <th>ID</th>
          <th>Usuario</th>
          <th>Total</th>
          <th>Estado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      {{range .}}
      <tbody class="order-block" id="order-{{.Id}}">
        <tr class="order-row">
          <td>{{.Id}}</td>
          <td>{{.User}}</td>
          <td>₡{{.Total}}</td>
          <td>{{OrderStatusName .Status}}</td>
          <td>
            {{if or (eq .Status 0) (eq .Status 1)}}
              <button
              class="btn btn-compact"
              hx-patch="/dashboard/orders/{{.Id}}/status"
              hx-vals='{"status":"3"}'
              hx-target="#msg-{{.Id}}"
              hx-swap="innerHTML"
              >Aceptar</button>
              <button
              class="btn btn-compact"
              hx-patch="/dashboard/orders/{{.Id}}/status"
              hx-vals='{"status":"1"}'
              hx-target="#msg-{{.Id}}"
              hx-swap="innerHTML"
              >Denegar</button>
            {{else if eq .Status 3}}
              <button
              class="btn btn-compact"
              hx-patch="/dashboard/orders/{{.Id}}/status"
              hx-vals='{"status":"4"}'
              hx-target="#msg-{{.Id}}"
              hx-swap="innerHTML"
              >Marcar cumplida</button>
            {{end}}
            <span id="msg-{{.Id}}" class="row-msg"></span>
          </td>
        </tr>
        <tr class="order-ref-row">
          <td colspan="5">
            <span class="order-ref-label">Referencia</span>
            <code class="order-ref-num">{{.RefNum}}</code>
          </td>
        </tr>
      </tbody>
      {{end}}
    </table>
  {{end}}
</div>

{{end}}
