{{define "list-orders"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Órdenes</h3>
  {{if not .Orders}}
    <p class="empty-msg">No hay órdenes</p>
  {{else}}
    {{$isStaff := .IsStaff}}
    {{$endpoint := "/dashboard/orders"}}
    {{$target := "#db-order-list"}}
    <table class="data-table order-list">
      <thead>
        <tr>
          {{if $isStaff}}
            {{template "sort-th" (dict "Field" "id"     "Label" "ID"      "Class" "order-col-id"     "Params" .Params "Endpoint" $endpoint "Target" $target)}}
            {{template "sort-th" (dict "Field" "user"   "Label" "Usuario" "Class" "order-col-user"   "Params" .Params "Endpoint" $endpoint "Target" $target)}}
            {{template "sort-th" (dict "Field" "total"  "Label" "Total"   "Class" "order-col-total"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
            {{template "sort-th" (dict "Field" "status" "Label" "Estado"  "Class" "order-col-status" "Params" .Params "Endpoint" $endpoint "Target" $target)}}
          {{else}}
            <th class="order-col-id">ID</th>
            <th class="order-col-total">Total</th>
            <th class="order-col-status">Estado</th>
          {{end}}
          <th class="order-col-actions">Acciones</th>
        </tr>
      </thead>
      {{range .Orders}}
        {{if not (or (eq .Status 2) (eq .Status 4))}}
          <tbody class="order-block" id="order-{{.Id}}">
            <tr class="order-row">
              <td class="order-col-id">
                <button
                type="button"
                class="order-id-link"
                hx-get="{{if $isStaff}}/dashboard/orders/{{.Id}}{{else}}/order/{{.Id}}{{end}}"
                hx-target="#order-detail-{{.Id}}"
                hx-swap="innerHTML"
                >{{.Id}}</button>
              </td>
              {{if $isStaff}}<td class="order-col-user">{{.User}}</td>{{end}}
              <td class="order-col-total">₡{{.Total}}</td>
              {{template "order-status" (dict "Id" .Id "Status" .Status "OOB" false)}}
              {{template "order-actions" (dict "Id" .Id "Status" .Status "IsStaff" $isStaff "OOB" false)}}
            </tr>
            <tr class="order-ref-row">
              <td colspan="5">
                <span class="order-ref-label">Referencia</span>
                {{template "order-ref-num" (dict "Id" .Id "RefNum" .RefNum "OOB" false)}}
              </td>
            </tr>
            <tr class="order-detail-row">
              <td colspan="5">
                <div id="order-detail-{{.Id}}" class="hx-slot"></div>
              </td>
            </tr>
          </tbody>
        {{end}}
      {{end}}
    </table>
    {{if $isStaff}}
      {{template "list-pagination" (dict "Params" .Params "HasNext" .HasNext "Endpoint" $endpoint "Target" $target)}}
    {{end}}
  {{end}}
</div>

{{end}}

{{define "order-ref-num"}}
<code id="order-ref-{{.Id}}" class="order-ref-num" {{if .OOB}}hx-swap-oob="true"{{end}}>{{.RefNum}}</code>
{{end}}

{{define "order-status"}}
<td id="order-status-{{.Id}}" class="order-col-status" {{if .OOB}}hx-swap-oob="true"{{end}}>{{OrderStatusName .Status}}</td>
{{end}}

{{define "order-actions"}}
<td id="order-actions-{{.Id}}" class="order-col-actions" {{if .OOB}}hx-swap-oob="true"{{end}}>
  {{template "buttons-order-actions" (dict
    "IsStaff" .IsStaff
    "Status"  .Status
    "Id"      .Id
  )}}
</td>
{{end}}
