{{define "list-orders"}}

{{$isStaff := .IsStaff}}
{{$showHistory := .ShowHistory}}
{{$endpoint := .Endpoint}}
{{$target := .Target}}
{{if and $isStaff $showHistory}}
  <div class="order-list-tools">
    <a class="btn btn-compact" href="/dashboard/orders/history/export?sort={{.Params.Sort}}&dir={{.Params.Dir}}" download>Exportar CSV</a>
  </div>
{{end}}
{{$anyVisible := false}}
{{range .Orders}}
  {{if or $showHistory (not (or (eq .Status 2) (eq .Status 4)))}}{{$anyVisible = true}}{{end}}
{{end}}
{{if not $anyVisible}}
  <p class="empty-msg">No hay órdenes</p>
{{else}}
  {{if $isStaff}}
    <div class="sort-bar">
      {{template "sort-link" (dict "Field" "id"     "Label" "ID"      "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "user"   "Label" "Usuario" "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "total"  "Label" "Total"   "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "status" "Label" "Estado"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
    </div>
  {{end}}
  <ul class="order-list">
    {{range .Orders}}
      {{if or $showHistory (not (or (eq .Status 2) (eq .Status 4)))}}
        {{template "order-row" (dict "Order" . "IsStaff" $isStaff)}}
      {{end}}
    {{end}}
  </ul>
  {{if $isStaff}}
    {{template "list-pagination" (dict "Params" .Params "HasNext" .HasNext "Endpoint" $endpoint "Target" $target)}}
  {{end}}
{{end}}

{{end}}

{{define "order-row"}}
{{$o := .Order}}
{{$isStaff := .IsStaff}}
{{$track := .Track}}
<li
class="order-entry{{if $track}} order-entry-current{{end}}"
id="order-{{$o.Id}}"
hx-get="{{if $isStaff}}/dashboard/orders/{{$o.Id}}{{else}}/order/{{$o.Id}}{{end}}"
hx-target="{{if $track}}#order-detail-{{$o.Id}}{{else if $isStaff}}#queue-detail{{else}}#orders-detail{{end}}"
hx-swap="innerHTML"
hx-trigger="click[!event.target.closest('button,a,input,form,.order-entry-detail')]"
{{if not $track}}data-aside-target="{{if $isStaff}}queue-detail{{else}}orders-detail{{end}}" data-id="{{$o.Id}}"{{end}}
>
  <div class="order-entry-main">
    <div class="order-entry-head">
      <span class="row-card-id">#{{$o.Id}}</span>
      {{if $isStaff}}<span class="order-entry-user">{{$o.User}}</span>{{end}}
      {{template "order-status" (dict "Id" $o.Id "Status" $o.Status "OOB" false)}}
    </div>
    {{if $track}}
      {{$s := $o.Status}}
      <div class="order-track">
        <span class="done">Recibida</span>
        <span class="{{if eq $s 0}}on{{else if eq $s 1}}denied{{else}}done{{end}}">Revisión</span>
        <span class="{{if eq $s 3}}on{{else if eq $s 4}}done{{end}}">Lista</span>
      </div>
    {{end}}
    <div class="order-entry-meta">
      <span class="order-entry-total">₡{{$o.Total}}</span>
      {{template "order-ref-slot" (dict "Id" $o.Id "RefNum" $o.RefNum)}}
    </div>
  </div>
  {{template "order-actions" (dict "Id" $o.Id "Status" $o.Status "IsStaff" $isStaff "OOB" false)}}
  <div id="order-detail-{{$o.Id}}" class="hx-slot order-entry-detail"></div>
</li>
{{end}}

{{define "order-ref-num"}}
<code id="order-ref-{{.Id}}" class="order-ref order-ref-num" {{if .OOB}}hx-swap-oob="true"{{end}}>{{GroupRef .RefNum}}</code>
{{end}}

{{define "order-status"}}
<span id="order-status-{{.Id}}" class="row-card-status{{if eq .Status 0}} status-unreviewed{{else if eq .Status 1}} status-denied{{else if eq .Status 3}} status-accepted{{end}}" {{if .OOB}}hx-swap-oob="true"{{end}}>{{OrderStatusName .Status}}</span>
{{end}}

{{define "order-actions"}}
<div id="order-actions-{{.Id}}" class="order-entry-actions{{if .IsStaff}} queue-entry-actions{{end}}" {{if .OOB}}hx-swap-oob="true"{{end}}>
  {{template "buttons-order-actions" (dict
    "IsStaff" .IsStaff
    "Status"  .Status
    "Id"      .Id
  )}}
</div>
{{end}}

{{define "queue-counts"}}
<div class="queue-tile"><b class="warn">{{.Unreviewed}}</b><span>Sin revisar</span></div>
<div class="queue-tile"><b class="ok">{{.Accepted}}</b><span>Aceptadas</span></div>
<div class="queue-tile"><b>{{.Denied}}</b><span>Denegadas</span></div>
<div class="queue-tile"><b>{{.FulfilledToday}}</b><span>Cumplidas hoy</span></div>
{{end}}

{{define "order-ref-slot"}}
<div id="order-ref-slot-{{.Id}}" class="order-ref-slot">
  {{template "order-ref-num" (dict "Id" .Id "RefNum" .RefNum "OOB" false)}}
</div>
{{end}}

{{define "order-ref-edit"}}
<div id="order-ref-slot-{{.Id}}" class="order-ref-slot order-ref-editing">
  <form class="order-ref-form" hx-patch="/order/update" hx-target="#order-ref-slot-{{.Id}}" hx-swap="outerHTML">
    <input
    class="field order-ref order-ref-input"
    type="text"
    name="ref_num"
    inputmode="numeric"
    pattern="[0-9]{25}"
    maxlength="25"
    value="{{.RefNum}}"
    aria-label="Número de referencia"
    required
    >
    <div class="order-ref-actions">
      <button class="btn btn-compact btn-primary" type="submit">Guardar</button>
      <button
      class="link-btn"
      type="button"
      hx-get="/order/ref-view"
      hx-target="#order-ref-slot-{{.Id}}"
      hx-swap="outerHTML"
      >Cancelar</button>
    </div>
  </form>
</div>
{{end}}
