{{define "list-sessions"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Sesiones activas</h3>
  {{if not .Sessions}}
    <p class="empty-msg">No hay sesiones activas</p>
  {{else}}
    {{$endpoint := "/dashboard/admin/sessions"}}
    {{$target := "#db-session-list"}}
    <table class="data-table">
      <tr>
        {{template "sort-th" (dict "Field" "user"    "Label" "Usuario" "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "role"    "Label" "Rol"     "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "starts"  "Label" "Inicio"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "expires" "Label" "Expira"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        <th>Acciones</th>
      </tr>
      {{range .Sessions}}
      <tr id="session-{{.User}}">
        <td>{{.User}}</td>
        <td>{{if eq .Role 1}}Personal{{else}}Cliente{{end}}</td>
        <td>{{UnixToTime .Starts}}</td>
        <td>{{UnixToTime .Expires}}</td>
        <td>
          <button
          class="btn btn-compact"
          hx-patch="/dashboard/admin/sessions/close/{{.User}}"
          hx-target="#msg-session-{{.User}}"
          hx-swap="innerHTML"
          hx-confirm="¿Cerrar la sesión de {{.User}}?"
          >Cerrar sesión</button>
          <span id="msg-session-{{.User}}" class="row-msg"></span>
        </td>
      </tr>
      {{end}}
    </table>
    {{template "list-pagination" (dict "Params" .Params "HasNext" .HasNext "Endpoint" $endpoint "Target" $target)}}
    <button
    class="btn btn-block"
    hx-patch="/dashboard/admin/sessions/close"
    hx-vals='{"users":"true","staff":"true"}'
    hx-target="#db-session-list"
    hx-swap="innerHTML"
    hx-confirm="¿Cerrar TODAS las sesiones activas?"
    >Cerrar todas las sesiones</button>
  {{end}}
</div>

{{end}}
