{{define "list-sessions"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Sesiones activas</h3>
  {{if not .Sessions}}
    <p class="empty-msg">No hay sesiones activas</p>
  {{else}}
    {{$endpoint := "/dashboard/admin/sessions"}}
    {{$target := "#db-session-list"}}
    <div class="sort-bar">
      {{template "sort-link" (dict "Field" "user"    "Label" "Usuario" "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "role"    "Label" "Rol"     "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "starts"  "Label" "Inicio"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
      {{template "sort-link" (dict "Field" "expires" "Label" "Expira"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
    </div>
    <ul class="row-card-list">
      {{range .Sessions}}
      <li class="row-card" id="session-{{.User}}">
        <div class="row-card-head">
          <span class="row-card-id">{{.User}}</span>
          <span class="row-card-status">{{if eq .Role 1}}Personal{{else}}Cliente{{end}}</span>
        </div>
        <dl class="row-card-fields">
          <div class="row-card-field">
            <dt>Inicio</dt>
            <dd>{{UnixToTime .Starts}}</dd>
          </div>
          <div class="row-card-field">
            <dt>Expira</dt>
            <dd>{{UnixToTime .Expires}}</dd>
          </div>
        </dl>
        <div class="row-card-actions">
          <button
          class="btn btn-compact btn-danger"
          hx-patch="/dashboard/admin/sessions/close/{{.User}}"
          hx-target="#msg-session-{{.User}}"
          hx-swap="innerHTML"
          hx-confirm="¿Cerrar la sesión de {{.User}}?"
          >Cerrar sesión</button>
          <span id="msg-session-{{.User}}" class="row-msg"></span>
        </div>
      </li>
      {{end}}
    </ul>
    {{template "list-pagination" (dict "Params" .Params "HasNext" .HasNext "Endpoint" $endpoint "Target" $target)}}
    <button
    class="btn btn-block btn-danger"
    hx-patch="/dashboard/admin/sessions/close"
    hx-vals='{"users":"true","staff":"true"}'
    hx-target="#db-session-list"
    hx-swap="innerHTML"
    hx-confirm="¿Cerrar TODAS las sesiones activas?"
    >Cerrar todas las sesiones</button>
  {{end}}
</div>

{{end}}
