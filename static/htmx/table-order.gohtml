{{define "table-order"}}

{{$isStaff := .IsStaff}}
{{$items := .ItemDetails}}
{{with .Order}}
  <table class="table-order">
    <tr class="order-row-id">
      <th>ID</th>
      <td>{{.Id}}</td>
    </tr>
    {{if $isStaff}}
      <tr class="order-row-user">
        <th>Usuario</th>
        <td>{{.User}}</td>
      </tr>
    {{end}}
    <tr class="order-row-time">
      <th>Hora</th>
      <td>{{UnixToTime .Time}}</td>
    </tr>
    <tr class="order-row-updated">
      <th>Actualizada</th>
      <td>{{if .Updated}}{{UnixToTime .Updated}}{{else}}—{{end}}</td>
    </tr>
    <tr class="order-row-items">
      <th>Desglose</th>
      <td>
        <table class="order-items-table">
          <thead>
            <tr>
              <th class="order-items-col-name"></th>
              <th class="order-items-col-price"></th>
            </tr>
          </thead>
          <tbody>
            {{range $items}}
              <tr>
                <td class="order-items-col-name">{{.Name}}{{if gt .Quant 1}} ×{{.Quant}}{{end}}</td>
                <td class="order-items-col-price">₡{{.Price}}</td>
              </tr>
            {{end}}
          </tbody>
          <tfoot>
            <tr class="order-items-total">
              <th class="order-items-col-name">TOTAL</th>
              <td class="order-items-col-price">₡{{.Total}}</td>
            </tr>
          </tfoot>
        </table>
      </td>
    </tr>
    <tr class="order-row-status">
      <th>Estado</th>
      <td>{{OrderStatusName .Status}}</td>
    </tr>
    <tr class="order-row-ref">
      <th>Referencia</th>
      <td>{{.RefNum}}</td>
    </tr>
    <tr class="order-row-close">
      <td colspan="2">
        <button
        type="button"
        class="btn btn-compact"
        hx-get="htmx/blank"
        hx-target="#order-detail-{{.Id}}"
        hx-swap="innerHTML"
        >Cerrar detalle</button>
      </td>
    </tr>
  </table>
{{end}}

{{end}}
