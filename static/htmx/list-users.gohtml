{{define "list-users"}}

<div class="hx-container">
  {{template "button-clear"}}
  <h3 class="panel-title">Usuarios</h3>
  {{if not .Users}}
    <p class="empty-msg">No hay usuarios</p>
  {{else}}
    {{$endpoint := "/dashboard/admin/users"}}
    {{$target := "#db-user-list"}}
    <table class="data-table">
      <tr>
        {{template "sort-th" (dict "Field" "username"     "Label" "Usuario" "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "time_created" "Label" "Creado"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        {{template "sort-th" (dict "Field" "active"       "Label" "Activo"  "Params" .Params "Endpoint" $endpoint "Target" $target)}}
        <th>Acciones</th>
      </tr>
      {{range .Users}}
      <tr id="user-{{.Username}}">
        <td>{{.Username}}</td>
        <td>{{UnixToTime .TimeCreated}}</td>
        {{template "user-active-cell" (dict "Username" .Username "Active" .Active "OOB" false)}}
        {{template "user-actions-cell" (dict "Username" .Username "Active" .Active "OOB" false)}}
      </tr>
      {{end}}
    </table>
    {{template "list-pagination" (dict "Params" .Params "HasNext" .HasNext "Endpoint" $endpoint "Target" $target)}}
  {{end}}
</div>

{{end}}

{{define "user-active-cell"}}
<td id="user-active-{{.Username}}" {{if .OOB}}hx-swap-oob="true"{{end}}>{{if .Active}}Sí{{else}}No{{end}}</td>
{{end}}

{{define "user-actions-cell"}}
<td id="user-actions-{{.Username}}" {{if .OOB}}hx-swap-oob="true"{{end}}>
  {{if .Active}}
  <button
  class="btn btn-compact"
  hx-patch="/dashboard/admin/users/deactivate/{{.Username}}"
  hx-vals='{"username":"{{.Username}}"}'
  hx-target="#msg-user-{{.Username}}"
  hx-swap="innerHTML"
  hx-confirm="¿Desactivar la cuenta de {{.Username}}?"
  >Desactivar</button>
  {{end}}
  <span id="msg-user-{{.Username}}" class="row-msg"></span>
</td>
{{end}}
