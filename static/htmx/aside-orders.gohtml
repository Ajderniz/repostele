{{define "aside-orders"}}
{{if not .Orders}}
  <p class="empty-msg">Sin órdenes pendientes</p>
{{else}}
  <ul class="aside-order-list">
    {{range .Orders}}
      <li id="aside-order-{{.Id}}" class="aside-order-item">
        <div class="aside-order-info">
          <span class="aside-order-id">#{{.Id}}</span>
          <span class="aside-order-user">{{.User}}</span>
          <span class="aside-order-total">₡{{.Total}}</span>
        </div>
        <div class="aside-order-actions">
          <button
          class="btn btn-compact"
          hx-patch="/dashboard/orders/{{.Id}}/status"
          hx-vals='{"status":"3"}'
          hx-target="#aside-msg-{{.Id}}"
          hx-swap="innerHTML"
          >Aceptar</button>
          <button
          class="btn btn-compact"
          hx-patch="/dashboard/orders/{{.Id}}/status"
          hx-vals='{"status":"1"}'
          hx-target="#aside-msg-{{.Id}}"
          hx-swap="innerHTML"
          >Denegar</button>
        </div>
        <span id="aside-msg-{{.Id}}" class="row-msg"></span>
      </li>
    {{end}}
  </ul>
{{end}}
{{end}}
