{{define "main-login"}}

{{with .Msg}}
  {{template "div-msg" .}}
{{else}}
  <div id="login-panel">
    {{template "form-login"}}
    {{if .IsUserApp}}
      <p class="auth-switch">
        ¿Aún no tiene cuenta?
        <button
        type="button"
        class="link-btn"
        hx-get="htmx/form-register-user"
        hx-target="#login-panel"
        hx-swap="innerHTML"
        >Regístrese aquí</button>
      </p>
    {{end}}
  </div>
{{end}}

{{end}}
