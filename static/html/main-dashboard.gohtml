{{define "main-dashboard"}}

<article class="page">
  <h1 class="page-title">Panel</h1>
  {{with .Msg}}
    {{template "div-msg" .}}
  {{else}}
    <div
    class="dash-tiles"
    hx-get="/dashboard/stats"
    hx-trigger="order-changed from:body, counts-changed from:body"
    hx-swap="innerHTML"
    >
      {{template "dash-tiles" .Stats}}
    </div>

    <div class="dash-tabs">
      <button
      class="dash-tab"
      hx-get="/dashboard/orders/history"
      hx-target="#dash-panel"
      hx-swap="innerHTML"
      >Historial</button>
      {{if .IsAdmin}}
        <button
        class="dash-tab"
        hx-get="htmx/form-create-item?hasNext=false"
        hx-target="#dash-panel"
        hx-swap="innerHTML"
        >Crear ítem</button>
        <button
        class="dash-tab"
        hx-get="/dashboard/admin/staff"
        hx-target="#dash-panel"
        hx-swap="innerHTML"
        >Personal</button>
        <button
        class="dash-tab"
        hx-get="/dashboard/admin/users"
        hx-target="#dash-panel"
        hx-swap="innerHTML"
        >Usuarios</button>
        <button
        class="dash-tab"
        hx-get="/dashboard/admin/sessions"
        hx-target="#dash-panel"
        hx-swap="innerHTML"
        >Sesiones</button>
      {{end}}
    </div>
    <div id="dash-panel" class="hx-slot"></div>
  {{end}}
</article>

{{end}}
