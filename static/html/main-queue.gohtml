{{define "main-queue"}}

<article class="page">
  <h1 class="page-title">Cola de órdenes</h1>
  <div
  id="queue-counts"
  class="queue-counts"
  hx-get="/dashboard/orders/counts"
  hx-trigger="load, order-changed from:body, counts-changed from:body"
  hx-swap="innerHTML"
  ></div>
  {{template "split-list" (dict "List" "queue-list" "Get" "/dashboard/orders" "Aside" "queue-detail")}}
</article>

{{end}}
