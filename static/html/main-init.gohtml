{{define "main-init"}}

{{with .}}
  {{template "div-msg" .Msg}}
{{else}}
  <div id="init-div">
    <h1>Repostele</h1>
    <h2>App de personal</h2>
    <h3>Aún no se ha configurado la app</h3>
    <button hx-get="htmx/form-register-staff" hx-target="#init-div" hx-swap="outerHTML">
      Iniciar ya
    </button>
  </div>
{{end}}

{{end}}
