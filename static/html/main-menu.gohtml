{{define "main-menu"}}

<article class="page">
  <h1 class="page-title">Menú</h1>
  {{$loggedIn := .LoggedIn}}
  {{$isAdmin := .IsAdmin}}
  {{$isStaff := .IsStaff}}
  {{$topMsg := .Msg}}
  {{if $isAdmin}}
    {{template "button-create-item" "menu-new-item"}}
  {{end}}
  <div id="menu-item-list">
    {{$anyVisible := false}}
    {{with .Data}}
      {{range .}}
        {{if or .Available $isAdmin}}
        {{$anyVisible = true}}
        {{template "menu-item" (dict
          "Item" .
          "LoggedIn" $loggedIn
          "IsStaff" $isStaff
          "IsAdmin" $isAdmin
          "OOB" false
        )}}
        {{end}}
      {{end}}
    {{end}}
    {{if not $anyVisible}}
      <p class="empty-msg">
      {{if $topMsg}}{{$topMsg}}{{else}}No hay ítemes disponibles{{end}}
      </p>
    {{end}}
  </div>
</article>

{{end}}
