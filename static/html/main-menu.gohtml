{{define "main-menu"}}

<article>
  <h1>Menú</h1>
  <div id="menu-item-list">
    {{$isAdmin := .IsAdmin}}
    {{$isStaff := .IsStaff}}
    {{with .Data}}
      {{range .}}
        {{if or .Available $isAdmin}}
        <div class="menu-item {{if not .Available}}unavailable{{end}}">
          <h3>{{.Name}} {{if not .Available}}(deshabilitado){{end}}</h3>
          <div><span>₡{{.Price}}</span></div>
          {{if .ImgPath}}
          <img src="{{.ImgPath}}" alt="{{.Name}}">
          {{end}}
          <p>{{.Desc}}</p>
          {{if $isStaff}}
          <button
          hx-get="/dashboard/admin/menu/{{.Id}}/edit"
          hx-target="#item-edit-{{.Id}}"
          hx-swap="innerHTML"
          >Editar</button>
          <div id="item-edit-{{.Id}}"></div>
          {{end}}
        </div>
        {{end}}
      {{end}}
    {{else}}
      <p>{{.Msg}}</p>
    {{end}}
  </div>
</article>

{{end}}
