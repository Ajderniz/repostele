{{define "base"}}

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} | Repostele {{.Server}}</title>
  <link rel="stylesheet" type="text/css" href="{{asset "/style.css"}}">
  <link rel="icon" type="image/x-icon" href="{{asset "/favicon.ico"}}">
  <script src="{{asset "/htmx.min.js"}}"></script>
  <script src="{{asset "/htmx-config.js"}}" defer></script>
  {{if eq .Server "User"}}<script src="{{asset "/cart.js"}}" defer></script>{{end}}
  <script src="{{asset "/toast.js"}}" defer></script>
  <script src="{{asset "/notif.js"}}" defer></script>
  <script src="{{asset "/orders.js"}}" defer></script>
  <script src="{{asset "/dashboard.js"}}" defer></script>
</head>
<body>
  <header id="site-header">Repostele</header>
  {{if .Init}}
    <nav id="site-nav">{{template "site-nav" .Nav}}</nav>
  {{end}}
  <main class="site-main">
    {{with .Err}}
      <div id="err-msg" class="banner banner-err">
        <p class="banner-text">{{.}}</p>
      </div>
    {{else}}
      {{CallTemplate .MainName .MainData}}
    {{end}}
  </main>
  <div id="toast-wrap"><div id="toast" class="toast" hidden></div></div>
  <div
  id="notif-poll"
  data-token=""
  hx-get="/htmx/notif"
  hx-trigger="load, every 10s [document.visibilityState=='visible'], notif-sync"
  hx-vals="js:{...notifParams()}"
  hx-swap="none"
  hidden
  ></div>
  <footer id="site-footer">2026, Repostele</footer>
</body>
</html>

{{end}}
