{{define "base"}}

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} | Repostele {{.Server}}</title>
  <link rel="stylesheet" type="text/css" href="/style.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <script src="/htmx.min.js"></script>
  <script src="/htmx-config.js" defer></script>
  <script src="/cart.js" defer></script>
  <script src="/toast.js" defer></script>
  <script src="/notif.js" defer></script>
  <script src="/orders.js" defer></script>
  <script src="/dashboard.js" defer></script>
</head>
<body>
  <header id="site-header">Repostele</header>
  {{if .Init}}
    <nav
    id="site-nav"
    hx-get="/htmx/nav"
    hx-trigger="load, every 30s"
    hx-swap="innerHTML"
    ></nav>
  {{end}}
  <main class="site-main">
    {{with .Err}}
      <div id="err-msg" class="banner banner-err">
        <p class="banner-text">{{.}}</p>
      </div>
    {{else}}
      {{CallTemplate .MainName .MainData}}
    {{end}}
  </main>
  <div id="toast-wrap"><div id="toast" class="toast" hidden></div></div>
  <div
  id="notif-poll"
  data-token=""
  hx-get="/htmx/notif"
  hx-trigger="load, every 10s, notif-sync"
  hx-vals="js:{...notifParams()}"
  hx-swap="none"
  hidden
  ></div>
  <footer id="site-footer">Footer</footer>
</body>
</html>

{{end}}
