{{define "base"}}

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} | Repostele {{.Server}}</title>
  <link rel="stylesheet" type="text/css" href="/style.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <script src="/htmx.min.js"></script>
  <script src="/csrf.min.js" defer></script>
</head>
<body>
  <header class="site-header">Repostele</header>
  <nav class="site-nav">
    {{if .Init}}
      <ul class="site-nav-list">
        <li><a href="/menu">Menú</a></li>
        {{if .LoggedIn}}
          {{if .IsStaff}}<li><a href="/dashboard">Panel</a></li>{{end}}
          <li><a href="/account">Cuenta</a></li>
          <li>
            <!-- TODO: make this work -->
            <button
            id="login-logout"
            class="site-nav-btn"
            type="submit"
            formaction="/logout"
            formmethod="patch"
            >Salir
            </button>
          </li>
        {{else}}
          <li><a href="/login" id="login-logout">Acceder</a></li>
        {{end}}
      </ul>
    {{end}}
  </nav>
  <main class="site-main">
    {{with .Err}}
      <div id="err-msg" class="banner banner-err">
        <p class="banner-text">{{.}}</p>
      </div>
    {{else}}
      {{CallTemplate .MainName .MainData}}
    {{end}}
  </main>
  <footer class="site-footer">Footer</footer>
</body>
</html>

{{end}}
